{
  "openapi": "3.1.0",
  "info": {
    "title": "BULSCA public API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/articles": {
      "get": {
        "operationId": "listArticles",
        "description": "Read-only. All matching pinned articles plus eight regular articles per page, newest created_at then id first. Unknown tag returns 404.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleList"
                }
              }
            }
          },
          "default": {
            "description": "Safe error response; 401/403/404/413/419/422/429/5xx. Retry-After is retained for throttling.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/articles/{slug}": {
      "get": {
        "operationId": "getArticle",
        "description": "Read-only. Resolves title.id legacy slugs and returns the canonical slug. Does not record views.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArticleResponse"
                }
              }
            }
          },
          "default": {
            "description": "Safe error response; 401/403/404/413/419/422/429/5xx. Retry-After is retained for throttling.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/client-errors": {
      "post": {
        "operationId": "reportClientError",
        "description": "Best-effort file diagnostics; 8 KiB body limit, 30 requests/minute/IP. Extra fields are ignored, not logged. Does not require cookies or database.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientErrorReport"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accepted"
                  ],
                  "properties": {
                    "accepted": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Safe error response; 401/403/404/413/419/422/429/5xx. Retry-After is retained for throttling.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tag": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Article": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "author",
          "excerpt",
          "pinned",
          "created_at",
          "updated_at",
          "views",
          "thumbs_up",
          "thumbs_down",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "thumbs_up": {
            "type": "integer",
            "minimum": 0
          },
          "thumbs_down": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          }
        },
        "additionalProperties": false
      },
      "ArticleDetail": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "author",
          "excerpt",
          "pinned",
          "created_at",
          "updated_at",
          "views",
          "thumbs_up",
          "thumbs_down",
          "tags",
          "content"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "views": {
            "type": "integer",
            "minimum": 0
          },
          "thumbs_up": {
            "type": "integer",
            "minimum": 0
          },
          "thumbs_down": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "content": {
            "type": "string",
            "description": "Allowlist-sanitized HTML; raw legacy HTML is never returned."
          }
        },
        "additionalProperties": false
      },
      "ArticleList": {
        "type": "object",
        "required": [
          "data",
          "meta",
          "links"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "pinned",
              "articles"
            ],
            "properties": {
              "pinned": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Article"
                }
              },
              "articles": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "required": [
              "current_page",
              "last_page",
              "per_page",
              "total"
            ],
            "properties": {
              "current_page": {
                "type": "integer",
                "minimum": 1
              },
              "last_page": {
                "type": "integer",
                "minimum": 1
              },
              "per_page": {
                "type": "integer",
                "const": 8
              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "links": {
            "type": "object",
            "required": [
              "prev",
              "next"
            ],
            "properties": {
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "ArticleResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ArticleDetail"
          }
        },
        "additionalProperties": false
      },
      "ApiError": {
        "type": "object",
        "required": [
          "message",
          "code",
          "request_id"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      },
      "ClientErrorReport": {
        "type": "object",
        "required": [
          "app",
          "app_version",
          "event_id",
          "category",
          "message",
          "route_template"
        ],
        "properties": {
          "app": {
            "type": "string",
            "enum": [
              "public",
              "portal"
            ]
          },
          "app_version": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9._-]+$"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "enum": [
              "network",
              "server",
              "invalid_response",
              "component",
              "route",
              "unhandled"
            ]
          },
          "message": {
            "type": "string",
            "enum": [
              "Request failed",
              "Unexpected interface error"
            ]
          },
          "route_template": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^/[a-zA-Z0-9_/:{}-]*$"
          },
          "status": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 400,
            "maximum": 599
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
