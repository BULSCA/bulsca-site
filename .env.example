APP_NAME='BULSCA'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=bulsca-vps.[tailnet-name].ts.net
DB_PORT=3306
DB_DATABASE=dev_yourproject
DB_USERNAME=devuser
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.[example.com]
MAIL_PORT=587
MAIL_USERNAME=noreply@bulsca.co.uk
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bulsca.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

META_ACCESS_TOKEN=your_long_lived_token_from_the_exchange
META_USER_ID=17841401606456844
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_POST_LIMIT=9

SSO_ENABLED=true
SSO_AUTH_SERVER=https://auth.bulsca.co.uk
SSO_CLIENT_ID=bulsca
SSO_CLIENT_SECRET=null

TURNSTILE_SECRET_KEY=null
