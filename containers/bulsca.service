[Unit]
Description=BULSCA release containers
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/bulsca/bulsca-site
ExecStart=%h/bulsca/bulsca-site/containers/compose.sh up -d --no-build
ExecStop=%h/bulsca/bulsca-site/containers/compose.sh stop
TimeoutStartSec=300

[Install]
WantedBy=default.target
