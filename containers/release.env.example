# Copy to .env.release, chmod 600, and set the exact paired Git commit tags.
BACKEND_TAG=
FRONTEND_TAG=
COMPOSE_PROJECT_NAME=bulsca
APP_NETWORK_SUBNET=10.89.40.0/24
PUBLIC_SITE_HOST=www.bulsca.co.uk
PUBLIC_API_HOST=api.bulsca.co.uk
PORTAL_HOST=portal.bulsca.co.uk
FRONTEND_PORT=8080
BACKEND_PORT=8081
TRUSTED_PROXIES=127.0.0.1,::1,10.89.40.0/24
STORAGE_VOLUME=bulsca-storage-v1
DB_VOLUME=bulsca-mysql-v1
# Preserve the existing key; changing it invalidates encrypted application data.
APP_KEY=
DB_DATABASE=bulsca
DB_USERNAME=bulsca
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SSO_ENABLED=true
SSO_AUTH_SERVER=https://auth.bulsca.co.uk
SSO_CLIENT_ID=bulsca
SSO_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Enable only after real captcha and SMTP acceptance tests.
CONTACT_FORM_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bulsca.co.uk
META_ACCESS_TOKEN=
META_USER_ID=
META_APP_ID=
META_APP_SECRET=
